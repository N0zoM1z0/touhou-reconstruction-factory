{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/touhou-reconstruction-factory/schemas/v1/service-config.schema.json",
  "title": "Factory service configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "state_directory",
    "evidence_store",
    "policy",
    "replay_timeout_seconds",
    "worker_lease_seconds",
    "worker_poll_seconds",
    "repositories"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "state_directory": {"type": "string", "minLength": 1},
    "evidence_store": {"type": "string", "minLength": 1},
    "policy": {"type": "string", "minLength": 1},
    "replay_timeout_seconds": {"type": "integer", "minimum": 1},
    "worker_lease_seconds": {"type": "integer", "minimum": 3},
    "worker_poll_seconds": {"type": "number", "exclusiveMinimum": 0},
    "analysis_providers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "repository_id",
          "target_identity_id",
          "backend",
          "timeout_seconds"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$"},
          "repository_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$"},
          "target_identity_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$"},
          "backend": {"enum": ["attested-ghidra-command-v1", "attested-ida-stdio-v1", "attested-ida-proxy-v1", "attested-ghidra-proxy-v1"]},
          "endpoint": {"type": "string", "minLength": 1},
          "upstream_tool": {"enum": ["ida_call", "ghidra_call"]},
          "command": {"type": "string", "minLength": 1},
          "arguments": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {"type": "string", "minLength": 1}
          },
          "target_path": {"type": "string", "minLength": 1},
          "implementation_files": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "implementation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}
        },
        "oneOf": [
          {
            "properties": {
              "backend": {"const": "attested-ghidra-command-v1"}
            },
            "required": ["command", "arguments", "target_path", "implementation_files", "implementation_sha256"],
            "not": {"anyOf": [{"required": ["endpoint"]}, {"required": ["upstream_tool"]}]}
          },
          {
            "properties": {
              "backend": {"const": "attested-ida-stdio-v1"}
            },
            "required": ["command", "arguments", "target_path"],
            "not": {"anyOf": [{"required": ["endpoint"]}, {"required": ["upstream_tool"]}, {"required": ["implementation_files"]}, {"required": ["implementation_sha256"]}]}
          },
          {
            "properties": {
              "backend": {"enum": ["attested-ida-proxy-v1", "attested-ghidra-proxy-v1"]}
            },
            "required": ["endpoint", "upstream_tool"],
            "not": {"anyOf": [{"required": ["command"]}, {"required": ["arguments"]}, {"required": ["target_path"]}, {"required": ["implementation_files"]}, {"required": ["implementation_sha256"]}]}
          }
        ]
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "root",
        "ttl_seconds",
        "max_active",
        "max_snapshot_files",
        "max_snapshot_bytes",
        "max_file_bytes",
        "command_timeout_seconds",
        "max_command_output_bytes",
        "max_patch_bytes"
      ],
      "properties": {
        "enabled": {"type": "boolean"},
        "root": {"type": "string", "minLength": 1},
        "ttl_seconds": {"type": "integer", "minimum": 1},
        "max_active": {"type": "integer", "minimum": 1},
        "max_snapshot_files": {"type": "integer", "minimum": 1},
        "max_snapshot_bytes": {"type": "integer", "minimum": 1},
        "max_file_bytes": {"type": "integer", "minimum": 1},
        "command_timeout_seconds": {"type": "integer", "minimum": 1},
        "max_command_output_bytes": {"type": "integer", "minimum": 1},
        "max_patch_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "adapter_id", "target_identity_ids"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$"},
          "path": {"type": "string", "minLength": 1},
          "adapter_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$"},
          "target_identity_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$"}
          }
        }
      }
    }
  }
}
