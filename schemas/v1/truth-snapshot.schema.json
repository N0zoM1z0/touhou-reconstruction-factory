{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://touhou-reconstruction.invalid/schemas/v1/truth-snapshot.schema.json",
  "title": "Touhou Reconstruction Truth Snapshot",
  "type": "object",
  "required": [
    "project",
    "products",
    "targets",
    "toolchains",
    "subjects",
    "claims",
    "oracle_results",
    "artifacts",
    "metrics",
    "diagnostics",
    "adapter_id",
    "input_fingerprint_sha256",
    "schema_version"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "adapter_id": { "$ref": "#/$defs/id" },
    "input_fingerprint_sha256": { "$ref": "#/$defs/sha256" },
    "project": { "$ref": "#/$defs/project" },
    "products": { "type": "array", "items": { "$ref": "#/$defs/product" } },
    "targets": { "type": "array", "items": { "$ref": "#/$defs/target" } },
    "toolchains": { "type": "array", "items": { "$ref": "#/$defs/toolchain" } },
    "subjects": { "type": "array", "items": { "$ref": "#/$defs/subject" } },
    "claims": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
    "oracle_results": { "type": "array", "items": { "$ref": "#/$defs/oracleResult" } },
    "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
    "metrics": { "type": "array", "items": { "$ref": "#/$defs/metric" } },
    "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "extent": {
      "type": "object",
      "required": ["address_space", "start", "size", "role", "sha256", "metadata"],
      "properties": {
        "address_space": { "$ref": "#/$defs/id" },
        "start": { "type": "string", "minLength": 1 },
        "size": { "type": "integer", "minimum": 1 },
        "role": { "enum": ["primary", "owned_chunk", "exclusion", "comparison"] },
        "sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "metadata": { "type": "object" }
      },
      "additionalProperties": false
    },
    "project": {
      "type": "object",
      "required": ["id", "name", "schema_version"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "schema_version": { "const": 1 }
      },
      "additionalProperties": false
    },
    "product": {
      "type": "object",
      "required": ["id", "project_id", "role", "target_identity_id", "required"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "project_id": { "$ref": "#/$defs/id" },
        "role": { "type": "string", "minLength": 1 },
        "target_identity_id": { "$ref": "#/$defs/id" },
        "required": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "required": ["id", "project_id", "product_id", "game", "version", "region", "format", "size", "sha256", "md5", "canonicality", "metadata"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "project_id": { "$ref": "#/$defs/id" },
        "product_id": { "$ref": "#/$defs/id" },
        "game": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "region": { "type": "string", "minLength": 1 },
        "format": { "type": "string", "minLength": 1 },
        "size": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "md5": { "anyOf": [{ "type": "string", "pattern": "^[0-9a-f]{32}$" }, { "type": "null" }] },
        "canonicality": { "type": "string", "minLength": 1 },
        "metadata": { "type": "object" }
      },
      "additionalProperties": false
    },
    "toolchain": {
      "type": "object",
      "required": ["id", "project_id", "provider_id", "family", "fingerprint_sha256", "metadata"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "project_id": { "$ref": "#/$defs/id" },
        "provider_id": { "$ref": "#/$defs/id" },
        "family": { "type": "string", "minLength": 1 },
        "fingerprint_sha256": { "$ref": "#/$defs/sha256" },
        "metadata": { "type": "object" }
      },
      "additionalProperties": false
    },
    "subject": {
      "type": "object",
      "required": ["id", "target_identity_id", "kind", "name", "extents", "metadata"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "target_identity_id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["product", "function", "extent", "data", "source_unit", "object", "section", "image"] },
        "name": { "type": "string", "minLength": 1 },
        "extents": { "type": "array", "items": { "$ref": "#/$defs/extent" } },
        "metadata": { "type": "object" }
      },
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "required": ["id", "subject_id", "type", "target_identity_id", "value", "evidence_class", "toolchain_identity_id", "evidence_refs", "dependencies", "metadata"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "subject_id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["target_attested", "boundary_extent", "origin_classified", "source_present", "compile_succeeded", "codegen_exact", "owned_extent_exact", "relocation_data_exact", "source_ownership", "object_ownership", "physical_ownership", "semantic_ownership", "whole_build_closed", "whole_image_exact", "semantic_evidence", "portable_runtime_validated"] },
        "target_identity_id": { "$ref": "#/$defs/id" },
        "value": { "type": "object" },
        "evidence_class": { "enum": ["observed", "corroborated", "inferred", "unknown"] },
        "toolchain_identity_id": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "evidence_refs": { "type": "array", "items": { "type": "string" } },
        "dependencies": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "metadata": { "type": "object" }
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "required": ["domain", "expected_units", "observed_units", "complete", "notes"],
      "properties": {
        "domain": { "type": "string", "minLength": 1 },
        "expected_units": { "type": "integer", "minimum": 0 },
        "observed_units": { "type": "integer", "minimum": 0 },
        "complete": { "type": "boolean" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "oracleResult": {
      "type": "object",
      "required": ["id", "oracle_id", "oracle_version", "role", "claim_id", "claim_type", "target_identity_id", "coverage", "verdict", "evidence_refs", "toolchain_identity_id", "source_tree", "normalizations", "diagnostics", "duration_ms"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "oracle_id": { "$ref": "#/$defs/id" },
        "oracle_version": { "type": "string", "minLength": 1 },
        "role": { "enum": ["diagnostic", "acceptance"] },
        "claim_id": { "$ref": "#/$defs/id" },
        "claim_type": { "$ref": "#/$defs/claim/properties/type" },
        "target_identity_id": { "$ref": "#/$defs/id" },
        "coverage": { "$ref": "#/$defs/coverage" },
        "verdict": { "enum": ["pass", "fail", "incomplete", "error"] },
        "evidence_refs": { "type": "array", "items": { "type": "string" } },
        "toolchain_identity_id": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "source_tree": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "normalizations": { "type": "array", "items": { "type": "string" } },
        "diagnostics": { "type": "array", "items": { "type": "string" } },
        "duration_ms": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": ["id", "sha256", "media_type", "size", "retention_class", "producer"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "media_type": { "type": "string", "minLength": 1 },
        "size": { "type": "integer", "minimum": 0 },
        "retention_class": { "type": "string", "minLength": 1 },
        "producer": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "metric": {
      "type": "object",
      "required": ["name", "value", "scope_id", "unit", "total", "caveat"],
      "properties": {
        "name": { "$ref": "#/$defs/id" },
        "value": { "type": "number" },
        "scope_id": { "$ref": "#/$defs/id" },
        "unit": { "type": "string" },
        "total": { "anyOf": [{ "type": "number" }, { "type": "null" }] },
        "caveat": { "type": "string" }
      },
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "required": ["code", "severity", "message", "source"],
      "properties": {
        "code": { "$ref": "#/$defs/id" },
        "severity": { "enum": ["info", "warning", "error"] },
        "message": { "type": "string", "minLength": 1 },
        "source": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
