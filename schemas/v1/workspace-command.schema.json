{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/touhou-reconstruction-factory/schemas/v1/workspace-command.schema.json",
  "title": "Transactional workspace command record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "command_id",
    "workspace_id",
    "script_sha256",
    "relative_cwd",
    "timeout_seconds",
    "started_at",
    "finished_at",
    "state",
    "exit_code",
    "timed_out",
    "workspace_committed",
    "workspace_validation_error",
    "stdout_captured_bytes",
    "stdout_observed_bytes",
    "stderr_captured_bytes",
    "stderr_observed_bytes",
    "output_truncated"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "command_id": {"type": "string", "pattern": "^command:[0-9a-f]{32}$"},
    "workspace_id": {"type": "string", "pattern": "^workspace:[0-9a-f]{32}$"},
    "script_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relative_cwd": {"type": "string", "minLength": 1, "maxLength": 1024},
    "timeout_seconds": {"type": "integer", "minimum": 1},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": ["string", "null"], "format": "date-time"},
    "state": {"enum": ["running", "completed", "timed-out", "interrupted"]},
    "exit_code": {"type": ["integer", "null"]},
    "timed_out": {"type": "boolean"},
    "workspace_committed": {"type": "boolean"},
    "workspace_validation_error": {"type": ["string", "null"]},
    "stdout_captured_bytes": {"type": "integer", "minimum": 0},
    "stdout_observed_bytes": {"type": "integer", "minimum": 0},
    "stderr_captured_bytes": {"type": "integer", "minimum": 0},
    "stderr_observed_bytes": {"type": "integer", "minimum": 0},
    "output_truncated": {"type": "boolean"}
  }
}
