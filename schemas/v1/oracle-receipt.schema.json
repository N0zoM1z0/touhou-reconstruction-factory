{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://touhou-reconstruction.invalid/schemas/v1/oracle-receipt.schema.json",
  "title": "Touhou Reconstruction Factory Oracle Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_id", "created_utc", "repository_adapter_id", "oracle_id",
    "oracle_version", "claim", "source_before", "source_after", "target",
    "toolchain", "invocation", "result", "artifacts", "native_report_ref",
    "acceptance_errors", "schema_version", "runner_id", "runner_version",
    "runner_implementation_sha256", "runner_observed_after_sha256", "metadata"
  ],
  "properties": {
    "receipt_id": { "type": "string", "pattern": "^receipt:[0-9a-f]{64}$" },
    "created_utc": { "type": "string", "format": "date-time" },
    "repository_adapter_id": { "type": "string", "minLength": 1 },
    "oracle_id": { "$ref": "#/$defs/id" },
    "oracle_version": { "$ref": "#/$defs/sha256" },
    "claim": { "$ref": "#/$defs/claimBinding" },
    "source_before": { "$ref": "#/$defs/sourceBinding" },
    "source_after": { "$ref": "#/$defs/sourceBinding" },
    "target": { "$ref": "#/$defs/targetBinding" },
    "toolchain": { "$ref": "#/$defs/toolchainBinding" },
    "invocation": { "$ref": "#/$defs/invocation" },
    "result": { "$ref": "truth-snapshot.schema.json#/$defs/oracleResult" },
    "artifacts": {
      "type": "array",
      "items": { "$ref": "truth-snapshot.schema.json#/$defs/artifact" }
    },
    "native_report_ref": {
      "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }]
    },
    "acceptance_errors": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "schema_version": { "const": 1 },
    "runner_id": { "const": "touhou-reconstruction-factory.replay" },
    "runner_version": { "const": "1" },
    "runner_implementation_sha256": { "$ref": "#/$defs/sha256" },
    "runner_observed_after_sha256": { "$ref": "#/$defs/sha256" },
    "metadata": { "type": "object" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "(^/|(^|/)\\.\\.(/|$))" }
    },
    "sourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "git_commit", "git_tree", "repository_scope", "snapshot_sha256",
        "file_count", "dirty", "untracked_files"
      ],
      "properties": {
        "git_commit": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
        "git_tree": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
        "repository_scope": { "$ref": "#/$defs/relativePath" },
        "snapshot_sha256": { "$ref": "#/$defs/sha256" },
        "file_count": { "type": "integer", "minimum": 0 },
        "dirty": { "type": "boolean" },
        "untracked_files": { "type": "integer", "minimum": 0 }
      }
    },
    "targetBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_id", "repository_path", "declared_sha256",
        "observed_before_sha256", "observed_after_sha256", "declared_size",
        "observed_before_size", "observed_after_size"
      ],
      "properties": {
        "identity_id": { "$ref": "#/$defs/id" },
        "repository_path": { "$ref": "#/$defs/relativePath" },
        "declared_sha256": { "$ref": "#/$defs/sha256" },
        "observed_before_sha256": { "$ref": "#/$defs/sha256" },
        "observed_after_sha256": { "$ref": "#/$defs/sha256" },
        "declared_size": { "type": "integer", "minimum": 1 },
        "observed_before_size": { "type": "integer", "minimum": 1 },
        "observed_after_size": { "type": "integer", "minimum": 1 }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "logical_path", "sha256", "size", "file_count"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["file", "directory-tree", "native-attestation", "runtime"] },
        "logical_path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size": { "type": "integer", "minimum": 0 },
        "file_count": { "type": "integer", "minimum": 1 }
      }
    },
    "toolchainBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_id", "declared_fingerprint_sha256", "attestation", "components",
        "components_sha256", "observed_after_sha256", "environment_sha256",
        "environment_names"
      ],
      "properties": {
        "identity_id": { "$ref": "#/$defs/id" },
        "declared_fingerprint_sha256": { "$ref": "#/$defs/sha256" },
        "attestation": { "enum": ["verified", "observed", "unknown"] },
        "components": {
          "type": "array",
          "items": { "$ref": "#/$defs/component" }
        },
        "components_sha256": { "$ref": "#/$defs/sha256" },
        "observed_after_sha256": { "$ref": "#/$defs/sha256" },
        "environment_sha256": { "$ref": "#/$defs/sha256" },
        "environment_names": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "claimBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id", "claim_type", "claim_sha256", "subject_id",
        "subject_sha256", "extents"
      ],
      "properties": {
        "claim_id": { "$ref": "#/$defs/id" },
        "claim_type": { "type": "string", "minLength": 1 },
        "claim_sha256": { "$ref": "#/$defs/sha256" },
        "subject_id": { "$ref": "#/$defs/id" },
        "subject_sha256": { "$ref": "#/$defs/sha256" },
        "extents": {
          "type": "array",
          "items": { "$ref": "truth-snapshot.schema.json#/$defs/extent" }
        }
      }
    },
    "invocationStage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "argv", "cwd", "environment_sha256", "input_sha256"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "cwd": { "$ref": "#/$defs/relativePath" },
        "environment_sha256": { "$ref": "#/$defs/sha256" },
        "input_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "stageExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage_id", "exit_code", "timed_out", "duration_ms", "stdout_ref", "stderr_ref"
      ],
      "properties": {
        "stage_id": { "$ref": "#/$defs/id" },
        "exit_code": { "type": ["integer", "null"] },
        "timed_out": { "type": "boolean" },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "stdout_ref": { "$ref": "#/$defs/id" },
        "stderr_ref": { "$ref": "#/$defs/id" }
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["driver_id", "driver_version", "coldness", "stages", "executions"],
      "properties": {
        "driver_id": { "$ref": "#/$defs/id" },
        "driver_version": { "$ref": "#/$defs/sha256" },
        "coldness": {
          "enum": [
            "isolated-double-build", "clean-output-graph", "forced-recompile",
            "incremental", "unknown"
          ]
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/invocationStage" }
        },
        "executions": {
          "type": "array",
          "items": { "$ref": "#/$defs/stageExecution" }
        }
      }
    }
  }
}
