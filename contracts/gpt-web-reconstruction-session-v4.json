{
  "schema_version": 4,
  "id": "gpt-web-reconstruction-session-v4",
  "purpose": "Autonomous evidence-first reconstruction in a registered live game repository",
  "required_inputs": [
    "game_id",
    "objective",
    "stop_condition"
  ],
  "optional_inputs": [
    "scope_hint",
    "resume_commit"
  ],
  "design_principles": [
    "agent-autonomy-first",
    "atomic-tools-remain-composable",
    "framework-improves-accuracy-and-efficiency-without-replacing-judgment",
    "attempt-authority-is-broader-than-truth-admission-authority",
    "git-checkpoints-are-review-state-not-oracle-proof",
    "verification-planes-are-independent-but-feedback-is-coupled",
    "unknown-is-preferred-to-an-unsupported-claim"
  ],
  "workflow_phases": [
    "discover",
    "inspect-live-repository-state",
    "read-repository-instructions",
    "bound-work-packet",
    "collect-provisional-analysis",
    "edit-natural-source",
    "run-coupled-exact-and-production-feedback",
    "create-reviewable-git-checkpoints",
    "update-game-local-knowledge-if-durable",
    "replay-eligible-committed-claims",
    "report-each-verification-plane-and-unknown"
  ],
  "verification_planes": {
    "function_or_extent_exactness": {
      "claim_types": [
        "codegen_exact",
        "owned_extent_exact"
      ],
      "subject_kinds": [
        "function",
        "extent"
      ],
      "does_not_prove": [
        "whole_build_closed",
        "whole_image_exact",
        "runtime_storage_identity",
        "runtime_scenario_validated"
      ]
    },
    "production_closure": {
      "claim_types": [
        "whole_build_closed"
      ],
      "subject_kinds": [
        "product"
      ],
      "minimum_evidence": [
        "complete-declared-production-graph",
        "cold-compilation",
        "clean-link-with-zero-unresolved-symbols",
        "output-format-and-toolchain-attestation"
      ],
      "does_not_prove": [
        "codegen_exact",
        "whole_image_exact",
        "runtime_storage_identity",
        "runtime_scenario_validated"
      ]
    },
    "runtime_storage": {
      "claim_types": [
        "runtime_storage_identity"
      ],
      "subject_kinds": [
        "data",
        "runtime_scenario"
      ],
      "factory_live_provider": "unavailable",
      "does_not_prove": [
        "codegen_exact",
        "whole_build_closed",
        "runtime_scenario_validated"
      ]
    },
    "runtime_scenario": {
      "claim_types": [
        "runtime_scenario_validated"
      ],
      "subject_kinds": [
        "runtime_scenario"
      ],
      "required_bindings": [
        "reconstructed-artifact",
        "assets-and-writable-state",
        "runtime-environment",
        "input-sequence",
        "bounded-observables"
      ],
      "factory_live_provider": "unavailable",
      "does_not_prove": [
        "codegen_exact",
        "whole_build_closed",
        "whole_image_exact",
        "portable_runtime_validated"
      ]
    }
  },
  "feedback_loop": {
    "normal_order": [
      "cheap-static-checks",
      "affected-function-or-extent-replay",
      "production-translation-unit-compilation",
      "cold-whole-build-at-bounded-milestones"
    ],
    "whole_build_required_after": [
      "owner-or-storage-change",
      "abi-or-layout-change",
      "shared-header-change",
      "link-input-or-build-graph-change",
      "bounded-production-closure-milestone"
    ],
    "on_link_or_runtime_failure": [
      "preserve-independent-exact-results",
      "diagnose-owner-abi-layout-data-and-lifetime",
      "repair-natural-source-and-ledgers",
      "replay-every-affected-exact-unit",
      "repeat-product-closure"
    ]
  },
  "authorities": {
    "analysis": {
      "role": "target-attested source-hypothesis evidence",
      "exactness_credit": "none"
    },
    "repository_work": {
      "role": "live game-repository development",
      "reads_dirty_untracked_and_ignored_state": true,
      "game_repository_write": true,
      "local_git_commit": true,
      "git_push": false,
      "truth_promotion": false
    },
    "disposable_workspace": {
      "role": "optional isolated experiment",
      "default_for_reconstruction": false,
      "game_repository_write": false,
      "truth_promotion": false
    },
    "game_knowledge": {
      "role": "game-repository-local durable input",
      "canonical_path": ".reconstruction/game-knowledge.json",
      "web_may_commit": true,
      "factory_publication": "none",
      "allowed_statuses": [
        "observed",
        "reproduced",
        "unknown",
        "superseded"
      ]
    },
    "factory_knowledge": {
      "role": "local-Codex-reviewed cross-game publication",
      "web_write": false,
      "mcp_promotion": false
    },
    "replay": {
      "role": "committed-claim verification",
      "dirty_source_eligible": false
    },
    "acceptance_registry": {
      "role": "sole live Truth Kernel admission authority"
    }
  },
  "prohibitions": [
    "invent-identities-or-claims",
    "git-push",
    "erase-or-overwrite-preexisting-work-without-understanding-it",
    "claim-exactness-from-analysis",
    "claim-exactness-from-build-or-git-commit",
    "claim-production-closure-from-function-or-object-progress",
    "claim-runtime-validation-from-build-or-manual-prose",
    "publish-or-promote-game-local-knowledge",
    "use-factory-catalog-status-or-all-scope-in-game-knowledge",
    "turn-game-knowledge-into-a-session-journal",
    "use-inline-assembly-or-byte-embedding-as-a-routine-shortcut",
    "kill-unrelated-processes",
    "substitute-imported-progress-for-accepted-evidence",
    "hide-truncation-or-unknown-state"
  ],
  "checkpoint_rules": {
    "prefix": "gpt-web:",
    "when": "after one coherent reviewable unit and its available checks",
    "before_commit": [
      "inspect-status",
      "inspect-staged-diff",
      "stage-only-intended-files"
    ],
    "commit_is_exactness_evidence": false
  },
  "handoff_fields": [
    "session_status",
    "game_and_objective",
    "starting_and_ending_commit",
    "starting_and_ending_dirty_state",
    "bounded_scope",
    "analysis_evidence_and_attestation",
    "changed_files",
    "created_checkpoint_commits",
    "game_knowledge_changes",
    "tests_actually_run",
    "verification_plane_statuses",
    "accepted_truth_separate_from_candidate_results",
    "unknowns_and_blockers",
    "next_action"
  ]
}
